---
/** A link that reads as an action. `solid` for the primary move, `ghost` beside it. */
interface Props {
  href: string;
  variant?: 'solid' | 'ghost';
  class?: string;
}

const { href, variant = 'solid', class: className = '' } = Astro.props;

/*
 * `solid` hovers darker, not brighter. Accent used to be cyan, which read
 * clearly against chalk; in a monochrome system accent is white and chalk is
 * nearly white, so hovering toward it would be invisible. Slate is the step
 * that still carries black type.
 */
const variants = {
  solid: 'bg-chalk px-7 py-3.5 text-ground hover:bg-slate',
  ghost: 'border-b border-chalk pb-1 hover:border-accent hover:text-accent',
};
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-3 text-sm transition-colors duration-200',
    variants[variant],
    className,
  ]}
>
  <slot />
  <span
    aria-hidden="true"
    class="transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1"
  >
    &#8594;
  </span>
</a>
