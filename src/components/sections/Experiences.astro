---
import { experiences, indexEntries } from '../../data/experiences';

const total = String(indexEntries.length).padStart(2, '0');
---

<section class="sec t-dark index-sec" id="experiences" data-theme="dark">
  <div class="index-grid">
    <div>
      <h2 class="display d-m" style="max-width:10ch" data-split>{experiences.heading}</h2>
      <p class="lede" style="margin-top:1rem;color:var(--mut)">{experiences.lede}</p>

      <div style="margin-top:clamp(1.25rem,2.5vw,2rem)">
        <span class="index-count" data-index-count>01</span>
        <span class="meta" style="display:block;margin-top:0.75rem">
          of {total} entries
        </span>
      </div>
    </div>

    <ol class="index-list" data-index-list>
      {
        indexEntries.map((entry) => (
          <li>
            <span class="meta">{entry.year}</span>
            <span class="index-name">{entry.name}</span>
            <span class="meta">{entry.note}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
