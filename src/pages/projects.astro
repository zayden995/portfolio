---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ActionLink from '../components/ActionLink.astro';
import ProjectCarousel from '../components/ProjectCarousel.tsx';
import { projects } from '../data/projects';
---

<BaseLayout
  title="Projects"
  description="[A sentence about the kind of projects you take on and what they have in common.]"
>
  <PageHeader
    eyebrow="Projects"
    title="[Selected work]"
    lead="[A line about what ties this work together — the kind of problem, the kind of team, or the kind of outcome.]"
  />

  <Section eyebrow={`${projects.length} projects`} wide>
    <div data-reveal>
      <ProjectCarousel client:visible projects={projects} />
    </div>

    <div class="mt-12 flex flex-wrap gap-x-8 gap-y-4">
      <ActionLink href="/contact">Start a project</ActionLink>
      <ActionLink href="/about" variant="ghost">More about me</ActionLink>
    </div>
  </Section>
</BaseLayout>
