---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Statement from '../components/sections/Statement.astro';
import About from '../components/sections/About.astro';
import Involvements from '../components/sections/Involvements.astro';
import Skills from '../components/sections/Skills.astro';
import Experiences from '../components/sections/Experiences.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout>
  <Hero />
  <Statement />
  <About />
  <Involvements />
  <Experiences />
  <Skills />
  {/* Projects is hidden until it has real content. To restore it: re-add
      the import and <Projects /> here, flip Contact back to t-light/light,
      and put Projects back in navItems. It is a dark section, so it belongs
      between Skills (light) and Contact. */}
  <Contact />
</BaseLayout>
